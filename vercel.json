{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/ingest?mode=scheduled&limit=250&postLimit=500",
      "schedule": "0 0,12 * * *"
    },
    {
      "path": "/api/cron/ingest?mode=recover&limit=250&postLimit=500",
      "schedule": "5,15,25,35,45,55 * * * *"
    },
    {
      "path": "/api/cron/tag",
      "schedule": "8,18,28,38,48,58 * * * *"
    },
    {
      "path": "/api/cron/narrate",
      "schedule": "3,13,23,33,43,53 * * * *"
    },
    {
      "path": "/api/cron/groups",
      "schedule": "20,50 * * * *"
    },
    {
      "path": "/api/cron/comments",
      "schedule": "24,54 * * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 7 * * *"
    }
  ]
}
