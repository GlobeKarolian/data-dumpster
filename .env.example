# ---------------------------------------------------------------- required
# Postgres. On Vercel: Storage > Create > Neon, then copy the pooled URL.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Random secret used to encrypt platform tokens and BYO model keys at rest.
# openssl rand -base64 48
ENCRYPTION_KEY=""

# Auth.js session secret. openssl rand -base64 32
AUTH_SECRET=""

# Shared secret Vercel Cron presents when calling /api/cron/*.
# openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------- optional: seed admin user
SEED_ADMIN_EMAIL="matt@karolian.com"
SEED_ADMIN_PASSWORD=""

# ------------------------------------ optional: platform data access (per org)
# These can also be set per-org in Settings > Data Sources, which is preferred.
# Anything set here acts as a fallback default for every org.

# YouTube Data API v3 — free tier, 10k units/day. console.cloud.google.com
YOUTUBE_API_KEY=""

# Meta Graph API (Facebook Pages + Instagram Business).
# Needs a long-lived Page access token with pages_read_engagement +
# instagram_basic + instagram_manage_insights. Public competitor data on Meta is
# limited by design; see docs/DATA-ACCESS.md for what is and is not obtainable.
META_ACCESS_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""

# X / Twitter API v2 — optional owned-account timeline; verify current pricing.
TWITTER_BEARER_TOKEN=""

# TikTok Display API / Research API. Research API requires an approved
# application and is US/EU academic-or-commercial gated.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn Marketing API — owned pages only, no competitor data. Partner program.
LINKEDIN_ACCESS_TOKEN=""

# Bluesky — public AT Protocol, no key needed for public reads. App password
# lifts rate limits. bsky.app > Settings > App Passwords
BLUESKY_IDENTIFIER=""
BLUESKY_APP_PASSWORD=""

# ------------------------------------------ optional: default BYO model
# Users configure their own in Settings > Models. This is only the fallback.
DEFAULT_MODEL_PROVIDER="anthropic"
DEFAULT_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# ------------------------------------------------------ optional: delivery
# A global webhook is safe for report delivery only when it is explicitly
# pinned to one tenant. Reports fail closed if either value is absent or the
# schedule's org does not equal REPORT_SLACK_ORG_ID.
SLACK_WEBHOOK_URL=""
REPORT_SLACK_ORG_ID=""

# Scheduled report email. Resend is called through its HTTPS API; no SDK or
# provider credential is stored in the database.
RESEND_API_KEY=""
REPORT_FROM_EMAIL="Data Dumpster <reports@example.com>"

# Canonical production origin used in Slack download links.
APP_URL="https://pressbox-kappa.vercel.app"

# ------------------------------------------- optional: purchased public data
# Primary public-data vendor for Instagram, TikTok, Threads, X, and Reddit.
# ensembledata.com/client/dashboard
ENSEMBLEDATA_TOKEN=""

# Bright Data Web Scraper API. Closes the competitor gaps that no platform
# sells: TikTok (views, engagement rate by view), LinkedIn, and Facebook where
# Page Public Content Access has not been approved.
#
# Free tier is 5,000 records per month with no credit card, which is enough to
# pilot a full Boston landscape. Paid is roughly $0.75-1.50 per 1,000 records.
# brightdata.com/cp/setting/users -> API tokens
#
# READ docs/DATA-ACCESS.md FIRST. This data is public and the vendor holds
# SOC 2 and ISO 27001, but collection runs contrary to TikTok and LinkedIn
# terms of service. Enable it as a decision Legal made, not a default.
BRIGHTDATA_API_KEY=""
