# ---------------------------------------------------------------- required
# Postgres. On Vercel: Storage > Create > Neon, then copy the pooled URL.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Random secret used to encrypt platform tokens and BYO model keys at rest.
# openssl rand -base64 48
ENCRYPTION_KEY=""

# Auth.js session secret. openssl rand -base64 32
AUTH_SECRET=""

# Shared secret Vercel Cron presents when calling /api/cron/*.
# openssl rand -hex 32
CRON_SECRET=""
# Must match an actually configured external/Vercel dispatcher. Keep false when
# vercel.json has no crons so the UI never promises automation that cannot run.
AUTOMATION_DISPATCHER_ENABLED="false"

# ------------------------------------------------- optional: seed admin user
SEED_ADMIN_EMAIL="matt@karolian.com"
SEED_ADMIN_PASSWORD=""

# ------------------------------------ optional: platform data access (per org)
# These can also be set per-org in Settings > Data Sources, which is preferred.
# WARNING: values set here act as a fallback for every org. Do not configure an
# owned-account credential this way in a multi-org deployment. Until verified
# org-channel bindings ship, environment-owned credentials are single-org only.

# YouTube Data API v3 — free tier, 10k units/day. console.cloud.google.com
YOUTUBE_API_KEY=""

# Meta Graph API (Facebook Pages + Instagram Business).
# Needs a long-lived Page access token with pages_read_engagement +
# instagram_basic + instagram_manage_insights. Public competitor data on Meta is
# limited by design; see docs/DATA-ACCESS.md for what is and is not obtainable.
META_ACCESS_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""
# Instagram Business account id belonging to META_ACCESS_TOKEN. Required for
# Business Discovery lookups of other Instagram Business accounts.
META_IG_USER_ID=""

# X / Twitter API v2 — optional owned-account timeline; verify current pricing.
TWITTER_BEARER_TOKEN=""

# TikTok Display API / Research API. Research API requires an approved
# application and is US/EU academic-or-commercial gated.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Per-account OAuth credentials for the owned-account adapter. Access tokens
# expire quickly; retain the refresh token so collection can renew them.
TIKTOK_ACCESS_TOKEN=""
TIKTOK_REFRESH_TOKEN=""

# LinkedIn Marketing API — optional future owned-page path. Public competitor
# collection uses the deployment BRIGHTDATA_API_KEY below.
LINKEDIN_ACCESS_TOKEN=""

# Bluesky — public AT Protocol, no key needed for public reads. App password
# lifts rate limits. bsky.app > Settings > App Passwords
BLUESKY_IDENTIFIER=""
BLUESKY_APP_PASSWORD=""

# ------------------------------------------ optional: default BYO model
# Users configure their own in Settings > Models. This is only the fallback.
DEFAULT_MODEL_PROVIDER="anthropic"
DEFAULT_MODEL="claude-sonnet-5"
# Maximum output tokens for the environment fallback connection.
DEFAULT_MODEL_MAX_TOKENS="4096"

# Hosted providers.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Google Search Console powers the two Web Search tables in Weekly Reports.
# Preferred: grant a service account read access to both Search Console
# properties and paste its complete JSON credential into the first variable.
# Alternatively configure the OAuth client trio below. Never commit either.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=""
# Exact property identifiers from Search Console, for example
# sc-domain:bostonglobe.com or https://www.bostonglobe.com/.
GOOGLE_SEARCH_CONSOLE_GLOBE_SITE=""
GOOGLE_SEARCH_CONSOLE_BOSTON_SITE=""

# Azure OpenAI. The endpoint is the resource root, for example
# https://example.openai.azure.com.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""

# Any OpenAI-compatible gateway or hosted endpoint.
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""

# Local Ollama. No API key is required. Common value: http://localhost:11434
OLLAMA_BASE_URL=""

# Optional base-URL override for providers that support one. Prefer the
# provider-specific variables above where available.
MODEL_BASE_URL=""

# ------------------------------------------------------ optional: delivery
# A global webhook is safe for report delivery only when it is explicitly
# pinned to one tenant. Reports fail closed if either value is absent or the
# schedule's org does not equal REPORT_SLACK_ORG_ID.
SLACK_WEBHOOK_URL=""
REPORT_SLACK_ORG_ID=""

# Scheduled report email. Resend is called through its HTTPS API; no SDK or
# provider credential is stored in the database.
RESEND_API_KEY=""
REPORT_FROM_EMAIL="Data Dumpster <reports@example.com>"

# Canonical production origin used in Slack download links.
APP_URL="https://pressbox-kappa.vercel.app"

# ------------------------------------------- optional: purchased public data
# Reddit publisher-user source, X onboarding helper, and fallback only when
# Bright Data is absent for Instagram, TikTok, Threads, and X.
# ensembledata.com/client/dashboard
ENSEMBLEDATA_TOKEN=""

# Bright Data Web Scraper API. Primary purchased public source for Facebook,
# Instagram, TikTok, X, Threads, and LinkedIn. YouTube and Bluesky retain their
# sanctioned public interfaces; Reddit retains its publisher-user feed until a
# like-for-like Bright Data account dataset is verified.
#
# Free tier is 5,000 records per month with no credit card, which is enough to
# pilot a full Boston landscape. Paid is roughly $0.75-1.50 per 1,000 records.
# brightdata.com/cp/setting/users -> API tokens
#
# READ docs/DATA-ACCESS.md FIRST. This data is public and the vendor holds
# SOC 2 and ISO 27001, but collection runs contrary to TikTok and LinkedIn
# terms of service. Enable it as a decision Legal made, not a default.
BRIGHTDATA_API_KEY=""
APIFY_API_TOKEN=""
